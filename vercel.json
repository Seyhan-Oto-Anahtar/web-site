{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api-server": {
      "root": "artifacts/api-server",
      "framework": "express",
      "entrypoint": "src/app.ts"
    },
    "kilit-anahtari": {
      "root": "artifacts/kilit-anahtari",
      "framework": "vite",
      "outputDirectory": "dist/public",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "mockup-sandbox": {
      "root": "artifacts/mockup-sandbox",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api-server" } },
    { "source": "/(.*)", "destination": { "service": "kilit-anahtari" } }
  ]
}
